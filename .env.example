# ========================================================
# BrewLite Monorepo Environment Variables Example
# ========================================================

# --- PostgreSQL Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=brewlite
POSTGRES_PORT=5432

# --- Backend (NestJS) ---
PORT=4000
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/brewlite?schema=public
JWT_SECRET=brewlite_jwt_secret_key_sgu_2026_super_secure

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api
