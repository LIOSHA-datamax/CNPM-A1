{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🟢 Backend: NestJS",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run start:dev",
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "name": "🔵 Frontend: Next.js",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend"
    },
    {
      "name": "🐛 Backend: NestJS (Debug Breakpoint)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run start:debug",
      "cwd": "${workspaceFolder}/backend"
    }
  ],
  "compounds": [
    {
      "name": "🚀 Fullstack (Frontend + Backend)",
      "configurations": [
        "🟢 Backend: NestJS",
        "🔵 Frontend: Next.js"
      ],
      "stopAll": true
    }
  ]
}

