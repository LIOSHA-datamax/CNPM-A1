{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Chạy Fullstack (Backend + Frontend)",
      "dependsOn": [
        "🟢 Chạy Backend (NestJS)",
        "🔵 Chạy Frontend (Next.js)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "🟢 Chạy Backend (NestJS)",
      "type": "shell",
      "command": "npm run start:dev",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Starting Nest application.*|.*nest start.*",
          "endsPattern": ".*Nest application successfully started.*|.*BrewLite Backend API.*"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": false
      },
      "icon": {
        "id": "server",
        "color": "terminal.ansiGreen"
      }
    },
    {
      "label": "🔵 Chạy Frontend (Next.js)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*next dev.*",
          "endsPattern": ".*Ready in.*|.*Local:.*"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": false
      },
      "icon": {
        "id": "browser",
        "color": "terminal.ansiBlue"
      }
    },
    {
      "label": "🗄️ Khởi động Database (Docker Postgres)",
      "type": "shell",
      "command": "docker compose up -d postgres",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "icon": {
        "id": "database",
        "color": "terminal.ansiYellow"
      }
    },
    {
      "label": "💎 Mở Prisma Studio (Giao diện xem DB)",
      "type": "shell",
      "command": "npm run prisma:studio",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated"
      },
      "icon": {
        "id": "table",
        "color": "terminal.ansiCyan"
      }
    }
  ]
}

