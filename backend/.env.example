# Cấu hình CSDL PostgreSQL
# Lưu ý: Thay "admin" hoặc "postgrespassword" tương ứng với mật khẩu bạn đặt khi cài Postgres/Docker
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/brewlite?schema=public"

# Cổng khởi chạy Backend NestJS
PORT=4000

# Secret Key cho JWT Token
JWT_SECRET="brewlite_jwt_secret_key_sgu_2026_super_secure"
